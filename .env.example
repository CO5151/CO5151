# ==============================================================================
# LegalPilot-VN Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & Provider Settings
# ------------------------------------------------------------------------------
# Google Cloud Vertex AI or Gemini API
GEMINI_API_KEY=""
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_GENAI_USE_VERTEXAI=0

# Local LiteLLM / Ollama Endpoint
OPENAI_API_BASE="http://localhost:8000/v1"
OPENAI_API_KEY="sk-local-dummy"
DEFAULT_MODEL="gemini-2.5-flash"
LOCAL_FALLBACK_MODEL="openai/llama3.2"

# ------------------------------------------------------------------------------
# 2. Database Connections
# ------------------------------------------------------------------------------
# SQLite Enterprise Memory
SQLITE_DB_PATH="data/enterprise_compliance.db"

# Neo4j Graph Database
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="legalpilot2026"
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Qdrant Vector Database
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME="vietnamese_legal_clauses"

# ------------------------------------------------------------------------------
# 3. Security & Operational Guardrails
# ------------------------------------------------------------------------------
MAX_REFINE_LOOPS=3
MAX_RETRIEVAL_HOPS=2
MAX_DOC_TRAVERSALS=5
STATUTE_CACHE_TTL_SECONDS=86400
HUMAN_GATE_REQUIRE_TOKEN=true
DOS_QUERY_TIMEOUT_SECONDS=12
LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# 4. External Legal Portals
# ------------------------------------------------------------------------------
# Target URL/query template for live statutory verification (vbpl.vn)
VBPL_SEARCH_URL="https://vbpl.vn/pages/vbpq-timkiem.aspx?Keyword={keyword}"
VBPL_TARGET_QUERY="https://vbpl.vn/pages/vbpq-timkiem.aspx?Keyword={keyword}"

